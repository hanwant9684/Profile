modules = ["python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["unzip", "redis"]

[agent]
expertMode = true

[workflows]
runButton = "Run Bot with Redis"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Bot with Redis"

[[workflows.workflow]]
name = "Run Bot with Redis"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --bind 0.0.0.0 --port 6379 --daemonize no & python main.py; pkill redis-server"

[[ports]]
localPort = 6379
externalPort = 80
