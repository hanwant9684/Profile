modules = ["python-3.12"]
[nix]
channel = "stable-25_05"
packages = ["cacert", "cargo", "libiconv", "libuv", "libxcrypt", "libyaml", "openssl", "pkg-config", "postgresql", "redis", "rustc", "unzip"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Main Bot"

[[workflows.workflow]]
name = "Main Bot"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python main.py"

[[ports]]
localPort = 6379
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[userenv]

[userenv.shared]
